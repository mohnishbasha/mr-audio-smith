{
  "name": "@mr-audio-smith/pi-extension",
  "version": "1.0.0-rc.2",
  "private": false,
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "typebox": "^1.3.27"
  },
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --external @earendil-works/pi-coding-agent",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "overrides": {
    "undici": "^8.12.3"
  }
}
