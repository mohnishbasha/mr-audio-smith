AUDIO_SMITH_ENV=prod
AUDIO_SMITH_LOG_LEVEL=info
AUDIO_SMITH_LOG_FORMAT=pretty
AUDIO_SMITH_CACHE_DIR=~/.cache/audio-smith
AUDIO_SMITH_OUT_DIR=./audio
AUDIO_SMITH_VOICES_DIR=~/.config/audio-smith/voices
AUDIO_SMITH_DEFAULT_BACKEND=maya2
AUDIO_SMITH_MAYA2_URL=http://127.0.0.1:8080/v1
AUDIO_SMITH_LLM=ollama:qwen3:14b
OLLAMA_HOST=http://127.0.0.1:11434
AUDIO_SMITH_SERVER_HOST=127.0.0.1
AUDIO_SMITH_SERVER_PORT=7340
AUDIO_SMITH_STUDIO_PORT=7341
AUDIO_SMITH_QA_THRESHOLD=0.75
AUDIO_SMITH_MAX_FETCH_BYTES=5242880
AUDIO_SMITH_ALLOW_PRIVATE=false
