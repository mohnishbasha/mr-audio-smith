{
  "name": "@mr-audio-smith/player",
  "version": "1.0.0-rc.2",
  "private": false,
  "license": "MIT",
  "description": "Accessible, dependency-free <audio-smith-player> web component",
  "type": "module",
  "main": "dist/audio-smith-player.js",
  "module": "dist/audio-smith-player.js",
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "bun build src/index.ts --minify --target=browser --format=esm --outfile=dist/audio-smith-player.js && bun build src/index.ts --minify --target=browser --format=iife --outfile=dist/audio-smith-player.iife.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^4.1.12"
  }
}
